2-3. 알림 컨트롤러
controllers/alertController.js 파일 생성

const db = require('../config/db');

// 알림 목록 조회
exports.getAlerts = async (req, res) => {
    try {
        const greenhouseId = req.params.greenhouse_id;

        const [rows] = await db.execute(
            `SELECT *
             FROM alerts
             WHERE greenhouse_id = ?
             ORDER BY created_at DESC
             LIMIT 50`,
            [greenhouseId]
        );

        res.json({
            success: true,
            alerts: rows
        });

    } catch (error) {
        console.error('알림 조회 오류:', error);

        res.status(500).json({
            success: false,
            message: '알림 목록을 불러오지 못했습니다.'
        });
    }
};


// 알림 읽음 처리
exports.readAlert = async (req, res) => {
    try {
        const alertId = req.params.alert_id;

        const [result] = await db.execute(
            `UPDATE alerts
             SET is_read = 1
             WHERE alert_id = ?`,
            [alertId]
        );

        if (result.affectedRows === 0) {
            return res.status(404).json({
                success: false,
                message: '해당 알림을 찾을 수 없습니다.'
            });
        }

        res.json({
            success: true,
            message: '알림을 읽음 처리했습니다.'
        });

    } catch (error) {
        console.error('알림 읽음 처리 오류:', error);

        res.status(500).json({
            success: false,
            message: '알림 읽음 처리에 실패했습니다.'
        });
    }
};

2-4. 알림 라우터
routes/alert.js 파일 생성

const express = require('express');
const router = express.Router();

const alertController =
    require('../controllers/alertController');

// 알림 목록 조회
router.get('/:greenhouse_id', alertController.getAlerts);

// 알림 읽음 처리
router.patch('/read/:alert_id', alertController.readAlert);

module.exports = router;

2-5. server.js 수정
기존 server.js에 아래 라우터를 연결

const express = require('express');
const cors = require('cors');
const path = require('path');

const app = express();

app.use(cors());
app.use(express.json());

// 기존 라우터
app.use('/api/sensor', require('./routes/sensor'));
app.use('/api/images', require('./routes/image'));

// 새로 추가할 라우터
app.use('/api/dashboard', require('./routes/dashboard'));
app.use('/api/alerts', require('./routes/alert'));

app.use('/uploads', express.static(
    path.join(__dirname, 'uploads')
));

const PORT = process.env.PORT || 3000;

app.listen(PORT, () => {
    console.log(`서버 실행 (http://localhost:${PORT})`);
});

기존 server.js에 이미 설정된 코드가 있다면 전체를 덮어쓰지 말고, require와 app.use 부분만 추가
