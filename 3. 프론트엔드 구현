React를 사용하면 웹과 모바일에서 같은 화면 코드를 사용하면서 화면 크기에 따라 배치 변경 가능

3-1. React 프로젝트 생성
터미널에서 다음 명령어 실행

npm create vite@latest smartfarm-web -- --template react

cd smartfarm-web

npm install

npm run dev

개발 서버가 실행되면 안내된 주소로 접속. 일반적으로 http://localhost:5173


3-2. App.jsx
src/App.jsx 파일을 아래 코드로 작성

import { useEffect, useState } from 'react';
import './App.css';

const API_URL = 'http://localhost:3000/api';
const GREENHOUSE_ID = 1;

function App() {
    const [dashboard, setDashboard] = useState(null);
    const [alerts, setAlerts] = useState([]);
    const [activeTab, setActiveTab] = useState('dashboard');
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState('');

    // 대시보드 데이터 조회
    const fetchDashboard = async () => {
        try {
            const response = await fetch(
                `${API_URL}/dashboard/${GREENHOUSE_ID}`
            );

            if (!response.ok) {
                throw new Error('대시보드 조회 실패');
            }

            const data = await response.json();

            if (!data.success) {
                throw new Error(data.message);
            }

            setDashboard(data);
            setError('');

        } catch (error) {
            console.error(error);
            setError('서버에 연결할 수 없습니다.');
        } finally {
            setLoading(false);
        }
    };

    // 알림 목록 조회
    const fetchAlerts = async () => {
        try {
            const response = await fetch(
                `${API_URL}/alerts/${GREENHOUSE_ID}`
            );

            if (!response.ok) {
                throw new Error('알림 조회 실패');
            }

            const data = await response.json();

            if (data.success) {
                setAlerts(data.alerts);
            }

        } catch (error) {
            console.error(error);
        }
    };

    // 알림 읽음 처리
    const readAlert = async (alertId) => {
        try {
            const response = await fetch(
                `${API_URL}/alerts/read/${alertId}`,
                {
                    method: 'PATCH'
                }
            );

            if (!response.ok) {
                throw new Error('읽음 처리 실패');
            }

            await fetchAlerts();
            await fetchDashboard();

        } catch (error) {
            console.error(error);
            alert('알림 읽음 처리에 실패했습니다.');
        }
    };

    // 처음 실행할 때 데이터 조회
    useEffect(() => {
        fetchDashboard();
        fetchAlerts();

        // 10초마다 최신 데이터 갱신
        const interval = setInterval(() => {
            fetchDashboard();
            fetchAlerts();
        }, 10000);

        return () => clearInterval(interval);
    }, []);

    if (loading) {
        return <div className="loading">데이터를 불러오는 중입니다.</div>;
    }

    if (error && !dashboard) {
        return <div className="loading">{error}</div>;
    }

    const sensor = dashboard?.sensor;
    const analysis = dashboard?.analysis;
    const harvest = dashboard?.harvest;

    return (
        <div className="app">

            {/* 상단 영역 */}
            <header className="header">
                <div>
                    <h1>SMART FARM</h1>
                    <p>방울토마토 스마트 재배 관리 시스템</p>
                </div>

                <div className="header-info">
                    <span className="status-dot"></span>
                    시스템 모니터링 중
                </div>
            </header>

            {/* 메뉴 */}
            <nav className="navigation">
                <button
                    className={activeTab === 'dashboard' ? 'active' : ''}
                    onClick={() => setActiveTab('dashboard')}
                >
                    대시보드
                </button>

                <button
                    className={activeTab === 'alerts' ? 'active' : ''}
                    onClick={() => setActiveTab('alerts')}
                >
                    알림
                    {dashboard?.unread_count > 0 && (
                        <span className="badge">
                            {dashboard.unread_count}
                        </span>
                    )}
                </button>
            </nav>

            <main className="content">

                {error && (
                    <p className="error-message">{error}</p>
                )}

                {/* 대시보드 화면 */}
                {activeTab === 'dashboard' && (
                    <>
                        <section className="welcome">
                            <div>
                                <h2>재배 환경 현황</h2>
                                <p>
                                    현재 온실의 환경과 작물 생육 상태를 확인합니다.
                                </p>
                            </div>

                            <button onClick={() => {
                                fetchDashboard();
                                fetchAlerts();
                            }}>
                                새로고침
                            </button>
                        </section>

                        {/* 센서 데이터 */}
                        <section className="sensor-grid">

                            <SensorCard
                                title="온도"
                                value={sensor?.temperature}
                                unit="℃"
                                icon="🌡️"
                            />

                            <SensorCard
                                title="습도"
                                value={sensor?.humidity}
                                unit="%"
                                icon="💧"
                            />

                            <SensorCard
                                title="조도"
                                value={sensor?.light_intensity}
                                unit=" lux"
                                icon="☀️"
                            />

                            <SensorCard
                                title="토양 수분"
                                value={sensor?.soil_moisture}
                                unit="%"
                                icon="🌱"
                            />

                        </section>

                        {/* 생육 분석 및 수확 예측 */}
                        <section className="info-grid">

                            <div className="panel">
                                <h3>AI 생육 분석</h3>

                                {analysis ? (
                                    <>
                                        <InfoRow
                                            label="잎 상태"
                                            value={analysis.leaf_status}
                                        />

                                        <InfoRow
                                            label="열매 숙도"
                                            value={analysis.fruit_maturity}
                                        />

                                        <InfoRow
                                            label="이상 감지"
                                            value={
                                                analysis.abnormal_detected
                                                    ? '이상 감지'
                                                    : '이상 없음'
                                            }
                                        />

                                        <InfoRow
                                            label="분석 신뢰도"
                                            value={
                                                analysis.confidence == null
                                                    ? '-'
                                                    : `${(
                                                        Number(analysis.confidence) * 100
                                                    ).toFixed(1)}%`
                                            }
                                        />

                                        <p className="description">
                                            {analysis.abnormal_description ||
                                                '특이사항이 없습니다.'}
                                        </p>
                                    </>
                                ) : (
                                    <p>아직 AI 분석 데이터가 없습니다.</p>
                                )}
                            </div>

                            <div className="panel">
                                <h3>수확 예상 정보</h3>

                                {harvest ? (
                                    <>
                                        <div className="harvest-date">
                                            {harvest.predicted_date
                                                ? new Date(
                                                    harvest.predicted_date
                                                ).toLocaleDateString('ko-KR')
                                                : '-'}
                                        </div>

                                        <p>예상 수확일</p>

                                        <InfoRow
                                            label="남은 기간"
                                            value={
                                                harvest.days_remaining == null
                                                    ? '-'
                                                    : `${harvest.days_remaining}일`
                                            }
                                        />

                                        <InfoRow
                                            label="예측 신뢰도"
                                            value={
                                                harvest.confidence == null
                                                    ? '-'
                                                    : `${(
                                                        Number(harvest.confidence) * 100
                                                    ).toFixed(1)}%`
                                            }
                                        />
                                    </>
                                ) : (
                                    <p>아직 수확 예측 데이터가 없습니다.</p>
                                )}
                            </div>

                        </section>

                        {/* 자동 제어 기록 */}
                        <section className="panel control-panel">
                            <h3>자동 제어 기록</h3>

                            {dashboard?.controls?.length > 0 ? (
                                <div className="table-wrap">
                                    <table>
                                        <thead>
                                            <tr>
                                                <th>장치</th>
                                                <th>명령</th>
                                                <th>상태</th>
                                                <th>요청 시간</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            {dashboard.controls.map((item) => (
                                                <tr key={item.log_id}>
                                                    <td>{item.device_type}</td>
                                                    <td>{item.command}</td>
                                                    <td>{item.status}</td>
                                                    <td>
                                                        {item.requested_at
                                                            ? new Date(
                                                                item.requested_at
                                                            ).toLocaleString('ko-KR')
                                                            : '-'}
                                                    </td>
                                                </tr>
                                            ))}
                                        </tbody>
                                    </table>
                                </div>
                            ) : (
                                <p>자동 제어 기록이 없습니다.</p>
                            )}
                        </section>

                        <p className="update-time">
                            센서 및 알림 데이터는 10초마다 갱신됩니다.
                        </p>
                    </>
                )}

                {/* 알림 화면 */}
                {activeTab === 'alerts' && (
                    <section>
                        <div className="welcome">
                            <div>
                                <h2>알림 내역</h2>
                                <p>온실 환경 및 작물 상태 알림입니다.</p>
                            </div>
                        </div>

                        <div className="alert-list">
                            {alerts.length > 0 ? (
                                alerts.map((item) => (
                                    <div
                                        className={`alert-card ${
                                            item.is_read ? 'read' : 'unread'
                                        }`}
                                        key={item.alert_id}
                                    >
                                        <div className="alert-content">
                                            <strong>
                                                {item.alert_type || '스마트팜 알림'}
                                            </strong>

                                            <span className={`severity ${item.severity}`}>
                                                {item.severity}
                                            </span>

                                            <p>{item.message}</p>

                                            <small>
                                                {new Date(
                                                    item.created_at
                                                ).toLocaleString('ko-KR')}
                                            </small>
                                        </div>

                                        {!item.is_read && (
                                            <button
                                                onClick={() =>
                                                    readAlert(item.alert_id)
                                                }
                                            >
                                                읽음
                                            </button>
                                        )}
                                    </div>
                                ))
                            ) : (
                                <div className="empty">
                                    등록된 알림이 없습니다.
                                </div>
                            )}
                        </div>
                    </section>
                )}

            </main>
        </div>
    );
}


// 센서 카드
function SensorCard({ title, value, unit, icon }) {
    const displayValue =
        value === null || value === undefined
            ? '-'
            : Number(value).toLocaleString('ko-KR');

    return (
        <div className="sensor-card">
            <div className="sensor-title">
                <span>{icon}</span>
                <span>{title}</span>
            </div>

            <div className="sensor-value">
                {displayValue}
                <small>{unit}</small>
            </div>
        </div>
    );
}


// 정보 행
function InfoRow({ label, value }) {
    return (
        <div className="info-row">
            <span>{label}</span>
            <strong>{value ?? '-'}</strong>
        </div>
    );
}

export default App;

